### Get all patients
GET http://localhost:8080/api/patients

### Get patient by ID
GET http://localhost:8080/api/patients/1

### Add a patient
POST http://localhost:8080/api/patients
Content-Type: application/json

{
    "name": "Test Patient",
    "age": 25,
    "gender": "Female",
    "phone": "9876543210",
    "email": "test@example.com",
    "address": "Test Address"
}
### Update a patient
PUT http://localhost:8080/api/patients/1
Content-Type: application/json

{
    "name": "Updated Patient",
    "age": 26,
    "gender": "Female",
    "phone": "9876543210",
    "email": "updated@example.com",
    "address": "Updated Address"
}

### Get all doctors
GET http://localhost:8080/api/doctors

### Add a doctor
POST http://localhost:8080/api/doctors
Content-Type: application/json

{
    "name": "Dr. John",
    "specialization": "Cardiologist",
    "phone": "9876543210",
    "email": "doctor@example.com",
    "availability": "Monday - Friday"
}

### Get doctor by ID
GET http://localhost:8080/api/doctors/1

### Update doctor
PUT http://localhost:8080/api/doctors/1
Content-Type: application/json

{
    "name": "Dr. John Updated",
    "specialization": "Cardiologist",
    "phone": "9876543210",
    "email": "updateddoctor@example.com",
    "availability": "Monday - Saturday"
}

### Get all appointments
GET http://localhost:8080/api/appointments

### Get appointment by ID
GET http://localhost:8080/api/appointments/1

### Add an appointment
POST http://localhost:8080/api/appointments
Content-Type: application/json

{
    "patient": "John",
    "doctor": "Dr. John",
    "date": "2026-08-20",
    "time": "10:30",
    "reason": "Regular checkup",
    "status": "Scheduled"
}

### Update appointment
PUT http://localhost:8080/api/appointments/1
Content-Type: application/json

{
    "patient": "Updated Patient",
    "doctor": "Dr. John Updated",
    "date": "2026-08-21",
    "time": "11:00",
    "reason": "Follow-up visit",
    "status": "Completed"
}

### Get all medical records
GET http://localhost:8080/api/medical-records

### Get medical record by ID
GET http://localhost:8080/api/medical-records/1

### Add a medical record
POST http://localhost:8080/api/medical-records
Content-Type: application/json

{
    "patient": "John",
    "doctor": "Dr. John",
    "visitDate": "2026-08-20",
    "symptoms": "Fever and headache",
    "diagnosis": "Viral infection",
    "prescription": "Rest and prescribed medicine"
}

### Update medical record
PUT http://localhost:8080/api/medical-records/1
Content-Type: application/json

{
    "patient": "Updated Patient",
    "doctor": "Dr. John Updated",
    "visitDate": "2026-08-21",
    "symptoms": "Updated symptoms",
    "diagnosis": "Updated diagnosis",
    "prescription": "Updated prescription"
}

### Get patient count
GET http://localhost:8080/api/patients/count

### Get doctor count
GET http://localhost:8080/api/doctors/count

### Today's appointments
GET http://localhost:8080/api/appointments/today

### Completed appointments
GET http://localhost:8080/api/appointments/completed

### Pending appointments
GET http://localhost:8080/api/appointments/pending